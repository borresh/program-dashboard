# Copy to .env and fill in. .env is git-ignored; this file is not.
# No secret has a default anywhere in the project: an unset variable stops the
# application at startup rather than quietly connecting somewhere unintended.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=program_dashboard
POSTGRES_USER=program_dashboard
POSTGRES_PASSWORD=change-me

# --- Backend ----------------------------------------------------------------
# Used when the backend runs on the host, for example from an IDE or `mvn
# spring-boot:run`. Under docker compose the backend reaches Postgres over the
# compose network instead, and compose overrides this to postgres:5432.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/program_dashboard
SPRING_DATASOURCE_USERNAME=program_dashboard
SPRING_DATASOURCE_PASSWORD=change-me
SERVER_PORT=8080

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=4200
PROGRAM_DASHBOARD_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Fixed identifier of the HUMAN agent seeded by V1__init.sql. Answers submitted
# from the browser are attributed to it. Change this only if you also change the
# migration.
PROGRAM_DASHBOARD_HUMAN_AGENT_ID=00000000-0000-0000-0000-000000000001
